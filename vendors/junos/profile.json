{
  "schema-version": 1,
  "netos": "junos",
  "display-name": "Juniper Junos",
  "vendor": "juniper",
  "detection": {
    "gnmi-capability-modules": [
      "juniper"
    ],
    "snmp-sysdescr-patterns": [
      "Junos",
      "Juniper"
    ],
    "cli-show-version-patterns": [
      "Junos"
    ]
  },
  "gnmi": {
    "path-format": "module-prefix",
    "default-encoding": "json_ietf",
    "default-origin": "",
    "notification-style": "standard"
  },
  "netconf": {
    "default-port": 830
  },
  "snmp": {
    "profile-tags": [
      "juniper-junos"
    ],
    "version-regex": "Juniper Networks.*JUNOS\\s+(\\S+)"
  },
  "cli": {
    "prompt-hints": [
      ">",
      "#"
    ],
    "paging-disable": "set cli screen-length 0",
    "prompt-patterns": [
      "[\\r\\n]+[\\w\\-\\.:/\\[\\]\\~@]+(?:\\{[^}]+\\}){0,1}[>#\\$%] ?$"
    ],
    "error-patterns": [
      "(?i)syntax error",
      "(?i)unknown command",
      "(?i)invalid value",
      "error:",
      "missing argument",
      "[^\\r\\n]+ not found"
    ],
    "clean-shell": [
      "set cli screen-length 0",
      "set cli screen-width 511",
      "set cli complete-on-space off"
    ]
  },
  "yang": {
    "embedded-subpath": "",
    "repo-slugs": [
      "juniper"
    ]
  },
  "playground": {
    "url": "https://github.com/Arolo-Solutions/prelude-collector-playground/tree/main/vendors/junos",
    "examples": [
      "profile.json"
    ]
  }
}
