{
  "schema-version": 1,
  "netos": "nxos",
  "display-name": "Cisco NX-OS",
  "vendor": "cisco",
  "detection": {
    "gnmi-capability-modules": [
      "Cisco-NX-OS"
    ],
    "snmp-sysdescr-patterns": [
      "NX-OS",
      "Nexus"
    ],
    "cli-show-version-patterns": [
      "NX-OS"
    ]
  },
  "gnmi": {
    "path-format": "bare-slash",
    "default-encoding": "json",
    "default-origin": "device",
    "notification-style": "standard"
  },
  "netconf": {
    "default-port": 830
  },
  "snmp": {
    "profile-tags": [
      "cisco-nxos"
    ],
    "version-regex": "Cisco NX-OS.*[Vv]ersion\\s+(\\S+?)[,\\s]"
  },
  "cli": {
    "prompt-hints": [
      "#",
      ">"
    ],
    "paging-disable": "terminal length 0",
    "prompt-patterns": [
      "[\\r\\n]*[\\w+\\-\\.:\\/\\[\\]\\~]+(?:\\([^\\)]+\\)){0,1}(?:>|#|\\$) ?$"
    ],
    "error-patterns": [
      "% ?Invalid",
      "% ?Incomplete",
      "% ?Ambiguous",
      "% ?Permission denied",
      "% ?Authorization failed",
      "% ?Error",
      "[Ee]rror: ",
      "Syntax error",
      "[^\\r\\n]+ not found"
    ],
    "clean-shell": [
      "terminal length 0",
      "terminal width 511",
      "terminal session-timeout 0"
    ]
  },
  "yang": {
    "embedded-subpath": "vendor/cisco/nx",
    "repo-slugs": [
      "openconfig"
    ]
  },
  "playground": {
    "url": "https://github.com/Arolo-Solutions/prelude-collector-playground/tree/main/vendors/nxos",
    "examples": [
      "profile.json"
    ]
  }
}
